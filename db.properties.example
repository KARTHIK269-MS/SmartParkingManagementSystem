# ==========================================================
# Smart Parking Management System — Database Configuration
# ==========================================================
# INSTRUCTIONS:
# 1. Copy this file to 'db.properties':
#    cp db.properties.example db.properties
# 2. Update the credentials below with your local MySQL settings.
# 3. Alternatively, you can configure these via environment variables:
#    DB_URL, DB_USER, DB_PASSWORD
# ==========================================================

db.url=jdbc:mysql://localhost:3306/parking_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
db.user=root
db.password=your_database_password_here
